+static int nt36532_command(struct nt36532_panel *p, const struct nt36532_cmd *cmd)
+{
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(p->dsi); i++) {
+		struct mipi_dsi_msg msg = {
+			.channel = p->dsi[i]->channel,
+			.type = cmd->type,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = cmd->len,
+			.tx_buf = cmd->data,
+		};
+		ret = p->dsi[i]->host->ops->transfer(p->dsi[i]->host, &msg);
+		if (ret < 0)
+			return ret;
+		if (ret != cmd->len)
+			return -EIO;
+	}
+	if (cmd->delay_ms)
+		msleep(cmd->delay_ms);
+	return 0;
+}
+
+static int nt36532_pps(struct nt36532_panel *p)
+{
+	struct drm_dsc_config link = p->dsc;
+	struct drm_dsc_picture_parameter_set pps;
+	int i, ret;
+
+	/* DPU uses the full frame; the panel decoder on each link sees half. */
+	link.pic_width /= 2;
+	drm_dsc_pps_payload_pack(&pps, &link);
+	for (i = 0; i < ARRAY_SIZE(p->dsi); i++) {
+		ret = mipi_dsi_picture_parameter_set(p->dsi[i], &pps);
+		if (ret < 0)
+			return ret;
+		ret = mipi_dsi_compression_mode(p->dsi[i], true);
+		if (ret < 0)
+			return ret;
+	}
+	return 0;
+}
+
+static int nt36532_prepare(struct drm_panel *panel)
+{
+	struct nt36532_panel *p = to_nt36532(panel);
+	size_t n;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret)
+		return ret;
+	msleep(10);
+	ret = regulator_enable(p->enp);
+	if (ret)
+		goto supplies_off;
+	ret = regulator_enable(p->enn);
+	if (ret)
+		goto enp_off;
+	msleep(10);
+	/* Active-low descriptor: logical 1 is the stock physical low. */
+	gpiod_set_value_cansleep(p->reset, 1);
+	msleep(11);
+	gpiod_set_value_cansleep(p->reset, 0);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(p->reset, 1);
+	usleep_range(3000, 3500);
+	gpiod_set_value_cansleep(p->reset, 0);
+	msleep(10);
+
+	for (n = 0; n < p->desc->on_count; n++) {
+		const struct nt36532_cmd *cmd = &p->desc->on[n];
+
+		/* Send the decoder PPS immediately before stock sleep-out. */
+		if (cmd->type == MIPI_DSI_DCS_SHORT_WRITE && cmd->data[0] == MIPI_DCS_EXIT_SLEEP_MODE) {
+			ret = nt36532_pps(p);
+			if (ret)
+				goto bias_off;
+		}
+		ret = nt36532_command(p, cmd);
+		if (ret)
+			goto bias_off;
+	}
+	return 0;
+
+bias_off:
+	gpiod_set_value_cansleep(p->reset, 1);
+	regulator_disable(p->enn);
+	msleep(5);
+enp_off:
+	regulator_disable(p->enp);
+	msleep(5);
+supplies_off:
+	regulator_bulk_disable(ARRAY_SIZE(p->supplies), p->supplies);
+	return ret;
+}
+
+static int nt36532_unprepare(struct drm_panel *panel)
+{
+	struct nt36532_panel *p = to_nt36532(panel);
+	int ret, first = 0;
+	size_t n;
+
+	/* Complete power-down even when a DSI command fails. */
+	for (n = 0; n < p->desc->off_count; n++) {
+		ret = nt36532_command(p, &p->desc->off[n]);
+		if (ret && !first)
+			first = ret;
+	}
+	gpiod_set_value_cansleep(p->reset, 1);
+	ret = regulator_disable(p->enn);
+	if (ret && !first)
+		first = ret;
+	msleep(5);
+	ret = regulator_disable(p->enp);
+	if (ret && !first)
+		first = ret;
+	msleep(5);
+	ret = regulator_bulk_disable(ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret && !first)
+		first = ret;
+	return first;
+}
+
+static int nt36532_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode = drm_mode_duplicate(connector->dev, &nt36532_mode);
+
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = 274;
+	connector->display_info.height_mm = 171;
+	connector->display_info.bpc = 10;
+	return 1;
+}
+
+static enum drm_panel_orientation nt36532_get_orientation(struct drm_panel *panel)
+{
+	return to_nt36532(panel)->orientation;
+}
+static const struct drm_panel_funcs nt36532_funcs = {
+	.prepare = nt36532_prepare,
+	.unprepare = nt36532_unprepare,
+	.get_modes = nt36532_get_modes,
+	.get_orientation = nt36532_get_orientation,
+};
+
+static int nt36532_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct nt36532_panel *p;
+	struct mipi_dsi_host *host;
+	struct device_node *node;
+	const struct mipi_dsi_device_info info = { .type = "nt36532-secondary", .channel = 0 };
+	int i, ret;
+
+	p = devm_drm_panel_alloc(dev, struct nt36532_panel, panel, &nt36532_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	p->desc = of_device_get_match_data(dev);
+	p->supplies[0].supply = "vdd";
+	p->supplies[1].supply = "vddio";
+	p->supplies[2].supply = "avdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "panel supplies\n");
+	p->enp = devm_regulator_get(dev, "enp");
+	if (IS_ERR(p->enp))
+		return dev_err_probe(dev, PTR_ERR(p->enp), "positive bias\n");
+	p->enn = devm_regulator_get(dev, "enn");
+	if (IS_ERR(p->enn))
+		return dev_err_probe(dev, PTR_ERR(p->enn), "negative bias\n");
+	p->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset), "panel reset\n");
+	ret = of_drm_get_panel_orientation(dev->of_node, &p->orientation);
+	if (ret)
+		return ret;
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "dual backlight\n");
+
+	node = of_graph_get_remote_node(dev->of_node, 1, -1);
+	if (!node)
+		return -ENODEV;
+	host = of_find_mipi_dsi_host_by_node(node);
+	of_node_put(node);
+	if (!host)
+		return -EPROBE_DEFER;
+	p->dsi[0] = dsi;
+	p->dsi[1] = devm_mipi_dsi_device_register_full(dev, host, &info);
+	if (IS_ERR(p->dsi[1]))
+		return PTR_ERR(p->dsi[1]);
+	p->dsc.dsc_version_major = 1;
+	p->dsc.dsc_version_minor = 1;
+	p->dsc.bits_per_component = 10;
+	p->dsc.bits_per_pixel = 8 << 4;
+	p->dsc.pic_width = 2944;
+	p->dsc.pic_height = 1840;
+	p->dsc.slice_width = 736;
+	p->dsc.slice_height = 20;
+	/* msm uses slice_count per interface for a bonded display. */
+	p->dsc.slice_count = 2;
+	p->dsc.block_pred_enable = true;
+	p->dsc.convert_rgb = true;
+	p->dsc.line_buf_depth = 11;
+	drm_dsc_set_const_params(&p->dsc);
+	drm_dsc_set_rc_buf_thresh(&p->dsc);
+	ret = drm_dsc_setup_rc_params(&p->dsc, DRM_DSC_1_2_444);
+	if (ret)
+		return ret;
+	p->dsc.initial_scale_value = drm_dsc_initial_scale_value(&p->dsc);
+	ret = drm_dsc_compute_rc_parameters(&p->dsc);
+	if (ret)
+		return ret;
+	p->panel.prepare_prev_first = true;
+	mipi_dsi_set_drvdata(dsi, p);
+	for (i = 0; i < ARRAY_SIZE(p->dsi); i++) {
+		p->dsi[i]->lanes = 4;
+		p->dsi[i]->format = MIPI_DSI_FMT_RGB101010;
+		p->dsi[i]->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+					MIPI_DSI_MODE_LPM;
+		p->dsi[i]->dsc = &p->dsc;
+		ret = devm_mipi_dsi_attach(dev, p->dsi[i]);
+		if (ret)
+			return ret;
+	}
+	drm_panel_add(&p->panel);
+	return 0;
+}
+static void nt36532_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt36532_panel *p = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_disable(&p->panel);
+	drm_panel_unprepare(&p->panel);
+	drm_panel_remove(&p->panel);
+}
+static void nt36532_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct nt36532_panel *p = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_disable(&p->panel);
+	drm_panel_unprepare(&p->panel);
+}
+static const struct of_device_id nt36532_match[] = {
+	{ .compatible = "lenovo,tb520fu-tianma-nt36532", .data = &tianma_desc },
+	{ .compatible = "lenovo,tb520fu-boe-nt36532", .data = &boe_desc },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, nt36532_match);
+static struct mipi_dsi_driver nt36532_driver = {
+	.probe = nt36532_probe,
+	.remove = nt36532_remove,
+	.shutdown = nt36532_shutdown,
+	.driver = { .name = "panel-novatek-nt36532", .of_match_table = nt36532_match },
+};
+module_mipi_dsi_driver(nt36532_driver);
+MODULE_DESCRIPTION("Lenovo TB520FU NT36532 dual D-PHY panel");
+MODULE_LICENSE("GPL");
