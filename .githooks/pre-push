#!/bin/sh
# This WSL checkout publishes only the TB520FU branch to its own fork.
set -eu
case "${2:-}" in
    https://github.com/wnduddld0513/linux-tb520fu|https://github.com/wnduddld0513/linux-tb520fu.git|git@github.com:wnduddld0513/linux-tb520fu.git|ssh://git@github.com/wnduddld0513/linux-tb520fu.git) ;;
    *)
        echo "Push blocked: destination must be wnduddld0513/linux-tb520fu." >&2
        exit 1
        ;;
esac
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_ref" != refs/heads/tb520fu ] || [ "$remote_ref" != refs/heads/tb520fu ]; then
        echo "Push blocked: only tb520fu -> tb520fu is allowed (no main, tags or deletions)." >&2
        exit 1
    fi
done
